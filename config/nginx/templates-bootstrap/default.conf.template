server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${ROOT_DOMAIN} ${DOMAIN} _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        default_type text/plain;
        return 200 "TLS certificate bootstrap in progress.\n";
    }
}
