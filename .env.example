COMPOSE_PROJECT_NAME=xiaoruru
TZ=Asia/Shanghai

# Public names. Create an A record for every name before bootstrap.
XUI_DOMAIN=3x-ui.xiaoruru.beer
NGINX_UI_DOMAIN=nginx-ui.xiaoruru.beer
CPAMP_DOMAIN=cpa-mp.xiaoruru.beer
CPA_API_DOMAIN=cli-proxy-api.xiaoruru.beer
GOST_DOMAIN=www.xiaoruru.beer
BLOG_DOMAIN=xiaoruru.beer
CERT_NAME=xiaoruru-services
LE_EMAIL=
LE_STAGING=0

# Pinned container versions
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.7.0
NGINX_UI_IMAGE=uozi/nginx-ui:v2.5.10
GOST_IMAGE=gogost/gost:3.2.6
CERTBOT_IMAGE=certbot/certbot:v5.7.0
PANEL_INIT_IMAGE=python:3.13.7-alpine3.22

# Public ports
HTTP_PORT=80
HTTPS_PORT=443
XRAY_PORT=8443
GOST_PORT=9443

# Internal-only 3x-ui ports
XUI_PANEL_PORT=2053
XUI_SUB_PORT=2096
XUI_WEB_BASE_PATH=/
XUI_MEMORY_LIMIT_MB=400

# Idempotent panel bootstrap
PRIMARY_CLIENT_EMAIL=jun-main
REALITY_MIN_CLIENT_VER=1.0.0
REALITY_TARGET_CANDIDATES=

# Shared by this stack and the separate CPAMP Compose project.
GATEWAY_NETWORK=xiaoruru-gateway
DOCKER_SUBNET=172.30.60.0/24

# Blog: credentials and optional AI settings live in config/rurublog/application.yml.
BLOG_IMAGE=xiaoruru/rurublog:local
BLOG_BUILD_TARGET=runtime
BLOG_UID=10001
BLOG_GID=10001
BLOG_MEMORY_LIMIT=768m
BLOG_CPUS=1.0
BLOG_JAVA_OPTIONS='-Xms64m -Xmx320m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -Xss512k -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError'

# Nginx UI uses the same initial administrator credentials as 3x-ui.
XUI_ADMIN_USERNAME=change_me
XUI_ADMIN_PASSWORD=change_me_to_a_long_random_password
GOST_USERNAME=change_me
GOST_PASSWORD=change_me_to_a_long_random_password
