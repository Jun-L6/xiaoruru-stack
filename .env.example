COMPOSE_PROJECT_NAME=xiaoruru
TZ=Asia/Shanghai

# Public names
DOMAIN=www.xiaoruru.beer
ROOT_DOMAIN=xiaoruru.beer
LE_EMAIL=
LE_STAGING=0

# Pinned container versions
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v3.7.0
NGINX_IMAGE=nginx:1.30.4-alpine
GOST_IMAGE=gogost/gost:3.2.6
CERTBOT_IMAGE=certbot/certbot:v5.7.0
PANEL_INIT_IMAGE=python:3.13.7-alpine3.22

# Public ports
HTTP_PORT=80
HTTPS_PORT=443
XRAY_PORT=8443
GOST_PORT=9443

# Internal-only 3x-ui ports
XUI_PANEL_PORT=2053
XUI_SUB_PORT=2096
XUI_WEB_BASE_PATH=/
XUI_MEMORY_LIMIT_MB=400

# Idempotent panel bootstrap
PRIMARY_CLIENT_EMAIL=jun-main
REALITY_MIN_CLIENT_VER=1.0.0
# Empty means: let 3x-ui scan its built-in public target candidates.
REALITY_TARGET_CANDIDATES=

# Choose a subnet that does not overlap the server VPC or other Docker networks.
DOCKER_SUBNET=172.30.60.0/24

# Generate unique values before deployment. Keep this file private.
XUI_ADMIN_USERNAME=change_me
XUI_ADMIN_PASSWORD=change_me_to_a_long_random_password
GOST_USERNAME=change_me
GOST_PASSWORD=change_me_to_a_long_random_password
