# 小茹茹博客 / rurublog — Docker Compose 配置模板。
# 用 scripts/docker.sh init 创建 .env，不要提交真实 .env。
# 带 $、#、空格的值使用单引号；BCrypt 哈希不要改成 $$。
# 可留空，改为在 config/application.yml 中直接填写 blog.admin.secret。
BLOG_ADMIN_SECRET_HASH=''
BLOG_DB_PASSWORD=''
BLOG_PUBLIC_URL=http://localhost:8080
BLOG_COOKIE_SECURE=false

# 默认仅供本机/Nginx 访问；确需直接对外开放时改为 0.0.0.0。
RURUBLOG_BIND_ADDRESS=127.0.0.1
RURUBLOG_PORT=8080
RURUBLOG_DATA_DIR=./data
TZ=Asia/Shanghai
# init 会把当前非 root 用户的 UID/GID 追加到 .env。
# root 执行 init 时使用 10001:10001，并只设置新建 data 目录的属主。
# 已有数据目录或迁移主机时，请检查实际属主并相应设置这两个值。
# RURUBLOG_UID=10001
# RURUBLOG_GID=10001

BLOG_AI_ENABLED=false
BLOG_AI_BASE_URL=https://api.openai.com
BLOG_AI_COMPLETIONS_PATH=/v1/chat/completions
BLOG_AI_API_KEY=''
BLOG_AI_MODEL=gpt-4o-mini
BLOG_AI_TIMEOUT=45s
BLOG_AI_AUTO_RUN=true
BLOG_AI_DELAY=10s

BLOG_BACKUP_ENABLED=true
BLOG_BACKUP_CRON='0 0 3 * * *'
BLOG_BACKUP_RETENTION=7
BLOG_UPLOAD_MAX_SIZE=20MB
JAVA_TOOL_OPTIONS='-Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC'
