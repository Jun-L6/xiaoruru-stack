[Unit]
Description=小茹茹博客 / rurublog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rurublog
Group=rurublog
WorkingDirectory=/opt/rurublog
EnvironmentFile=/etc/rurublog/rurublog.env
ExecStart=/usr/bin/java -Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -Djava.io.tmpdir=/var/lib/rurublog/temp -jar /opt/rurublog/rurublog.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rurublog
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
