BLOG_DATA_DIR=/var/lib/rurublog
BLOG_PUBLIC_URL=https://blog.example.com
BLOG_ADMIN_SECRET_HASH={bcrypt}$2a$10$REPLACE_WITH_GENERATED_HASH
BLOG_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
BLOG_COOKIE_SECURE=true

BLOG_AI_ENABLED=true
BLOG_AI_BASE_URL=https://api.openai.com
BLOG_AI_COMPLETIONS_PATH=/v1/chat/completions
BLOG_AI_API_KEY=REPLACE_WITH_API_KEY
BLOG_AI_MODEL=gpt-4o-mini
BLOG_AI_TIMEOUT=45s

BLOG_BACKUP_ENABLED=true
BLOG_BACKUP_CRON="0 0 3 * * *"
BLOG_BACKUP_RETENTION=7
BLOG_UPLOAD_MAX_SIZE=20MB
SERVER_PORT=8080
